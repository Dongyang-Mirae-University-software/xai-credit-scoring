# /etc/nginx/sites-available/__DOMAIN__  (치환: __DOMAIN__, __MLFLOW_PORT__ — README 3단계)
server {
    listen 80;
    server_name __DOMAIN__;

    auth_basic           "MLflow";
    auth_basic_user_file /etc/nginx/.htpasswd-mlflow;

    client_max_body_size 200m;     # 모델 아티팩트 업로드
    proxy_read_timeout   300s;

    location / {
        proxy_pass         http://127.0.0.1:__MLFLOW_PORT__;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}
